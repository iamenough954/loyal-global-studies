@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* LOYAL JI - Automatic Rainbow Animation */
.loyal-rainbow {
  display: inline-block;
  font-weight: 900;
  letter-spacing: 1px;
  background: linear-gradient(
    90deg,
    #ff1744,
    #ff9100,
    #ffea00,
    #00e676,
    #00b0ff,
    #651fff,
    #f500ff,
    #ff1744
  );
  background-size: 300% auto;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: loyal-rainbow-flow 5s linear infinite;
}

@keyframes loyal-rainbow-flow {
  from { background-position: 0% center; }
  to { background-position: 300% center; }
}

@media (prefers-reduced-motion: reduce) {
  .loyal-rainbow {
    animation: none;
    background-position: center;
  }
}

/* ===== LOYAL PREMIUM RAINBOW FOOTER ===== */
.loyal-rainbow {
  display: inline-block;
  font-weight: 900;
  letter-spacing: 1.5px;
  background: linear-gradient(
    90deg,
    #ff1744,
    #ff9100,
    #ffea00,
    #00e676,
    #00b0ff,
    #651fff,
    #f500ff,
    #ff1744
  );
  background-size: 300% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  animation: loyal-rainbow-flow 5s linear infinite;
  filter: drop-shadow(0 0 7px rgba(0, 200, 255, 0.22));
}

@keyframes loyal-rainbow-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}

/* Premium card hover effect */
.premium-card {
  transition: transform 250ms ease, border-color 250ms ease,
              box-shadow 250ms ease;
}

.premium-card:hover {
  transform: translateY(-4px);
  border-color: rgba(34, 211, 238, 0.55);
  box-shadow: 0 12px 35px rgba(8, 145, 178, 0.12);
}

::selection {
  background: rgba(34, 211, 238, 0.3);
}

@media (prefers-reduced-motion: reduce) {
  .loyal-rainbow,
  .premium-card {
    animation: none;
    transition: none;
  }
}
