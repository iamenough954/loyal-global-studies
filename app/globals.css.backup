@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* LOYAL JI - Automatic Rainbow Animation */
.loyal-rainbow {
  display: inline-block;
  font-weight: 900;
  letter-spacing: 1px;
  background: linear-gradient(
    90deg,
    #ff1744,
    #ff9100,
    #ffea00,
    #00e676,
    #00b0ff,
    #651fff,
    #f500ff,
    #ff1744
  );
  background-size: 300% auto;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: loyal-rainbow-flow 5s linear infinite;
}

@keyframes loyal-rainbow-flow {
  from { background-position: 0% center; }
  to { background-position: 300% center; }
}

@media (prefers-reduced-motion: reduce) {
  .loyal-rainbow {
    animation: none;
    background-position: center;
  }
}

/* ===== LOYAL PREMIUM RAINBOW FOOTER ===== */
.loyal-rainbow {
  display: inline-block;
  font-weight: 900;
  letter-spacing: 1.5px;
  background: linear-gradient(
    90deg,
    #ff1744,
    #ff9100,
    #ffea00,
    #00e676,
    #00b0ff,
    #651fff,
    #f500ff,
    #ff1744
  );
  background-size: 300% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  animation: loyal-rainbow-flow 5s linear infinite;
  filter: drop-shadow(0 0 7px rgba(0, 200, 255, 0.22));
}

@keyframes loyal-rainbow-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}

/* Premium card hover effect */
.premium-card {
  transition: transform 250ms ease, border-color 250ms ease,
              box-shadow 250ms ease;
}

.premium-card:hover {
  transform: translateY(-4px);
  border-color: rgba(34, 211, 238, 0.55);
  box-shadow: 0 12px 35px rgba(8, 145, 178, 0.12);
}

::selection {
  background: rgba(34, 211, 238, 0.3);
}

@media (prefers-reduced-motion: reduce) {
  .loyal-rainbow,
  .premium-card {
    animation: none;
    transition: none;
  }
}



/* LOYAL PROFESSIONAL COLOR UPGRADE */
:root {
  color-scheme: dark;
  --loyal-cyan: #22d3ee;
  --loyal-blue: #3b82f6;
  --loyal-violet: #a78bfa;
  --loyal-gold: #fbbf24;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: #070b16;
  background-image:
    radial-gradient(ellipse at 8% 0%, rgba(34, 211, 238, .10), transparent 34%),
    radial-gradient(ellipse at 95% 18%, rgba(139, 92, 246, .10), transparent 32%),
    radial-gradient(ellipse at 50% 100%, rgba(59, 130, 246, .07), transparent 40%);
  background-attachment: fixed;
}

::selection {
  color: #07101f;
  background: #67e8f9;
}

a, button, input, select, textarea {
  transition:
    color .2s ease,
    background-color .2s ease,
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--loyal-cyan);
  outline-offset: 4px;
}

button:not(:disabled):active {
  transform: scale(.98);
}

input, select, textarea {
  accent-color: var(--loyal-cyan);
}

[class*="rounded-2xl"][class*="border"]:hover,
[class*="rounded-3xl"][class*="border"]:hover {
  box-shadow: 0 12px 36px rgba(34, 211, 238, .08);
}

.loyal-rainbow {
  background-image: linear-gradient(
    90deg,
    #22d3ee,
    #60a5fa,
    #c084fc,
    #f472b6,
    #fbbf24,
    #34d399,
    #22d3ee
  );
  background-size: 250% auto;
  color: transparent;
  -webkit-background-clip: text;
  background-clip: text;
  animation: loyal-color-flow 7s linear infinite;
}

@keyframes loyal-color-flow {
  to { background-position: 250% center; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
